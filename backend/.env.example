# Адрес Keitaro без /admin_api/v1 и ключ Admin API
KEITARO_BASE_URL=https://your-keitaro-host.example
KEITARO_API_KEY=replace_me

# ID объектов вашего стенда: домен, группа кампаний и источник трафика
# Замените примеры ниже на существующие ID
KEITARO_DOMAIN_ID=1
KEITARO_GROUP_ID=1
KEITARO_TRAFFIC_SOURCE_ID=1

# Префикс названий ваших тестовых кампаний: test_фамилия_
CAMPAIGN_PREFIX=test_lastname_